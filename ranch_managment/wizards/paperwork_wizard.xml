<record id="view_reservation_wizard_form" model="ir.ui.view">
    <field name="name">reservation.wizard.form</field>
    <field name="model">reservation.wizard</field>
    <field name="arch" type="xml">
        <form string="Reservation Query Wizard">
            <group>
                <!-- Step 1: Date Inputs -->
                <field name="check_in_date" />
                <field name="check_out_date" />
            </group>
            <group>
                <!-- Step 2: Query Option -->
                <field name="query_option" />
            </group>
            <footer>
                <!-- Submit Button -->
                <button name="action_query_reservations"
                        type="object"
                        string="Execute Query"
                        class="btn-primary" />
                <button string="Cancel" special="cancel" class="btn-secondary" />
            </footer>
        </form>
    </field>
</record>
