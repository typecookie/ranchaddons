<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_yearly_ranch_data" model="ir.actions.act_window">
    <field name="name">Yearly Data</field>
    <field name="res_model">yearly.ranch.data</field>
    <field name="view_mode">tree,form</field>
</record>
<record id="view_yearly_ranch_data_tree" model="ir.ui.view">
    <field name="name">yearly.ranch.data.tree</field>
    <field name="model">yearly.ranch.data</field>
    <field name="arch" type="xml">
        <tree string="Ranch Data By Year">
            <field name="year"/>
            <field name="first_guest_week"/>
            <field name="last_guest_week"/>
            <field name="check_in_time"/>
            <field name="check_out_time"/>
        </tree>
    </field>
</record>

    <menuitem name="Yearly Ranch Data" id="yearly_ranch_data_menu" parent="ranch_management_base_menu" action="action_yearly_ranch_data"/>

</odoo>